cd ~/projects/mlops-practitioner
cat > .env.example << 'EOF'
# Required: LLM generation and RAGAS judge (free key: https://console.groq.com)
GROQ_API_KEY=

# Langfuse Cloud tracing (free account: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# MLflow / MinIO (only needed for experiment tracking via docker compose)
MLFLOW_TRACKING_URI=
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides (defaults are set in src/prodml/config.py)
EMBEDDING_MODEL=
LLM_MODEL=
JUDGE_MODEL=
JUDGE_EFFORT=
TOP_K=
EOF
